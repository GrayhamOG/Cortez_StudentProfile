# Copy this file to ".env" (which is git-ignored) and fill in your own values.
# NEVER commit the real .env file.

# Long random string used to sign login tokens. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=

PORT=3000

# Optional: comma-separated list of allowed origins. Leave empty to allow all
# (fine for class demos because the API uses bearer tokens, not cookies).
CORS_ORIGINS=

# Optional: where the SQLite file is stored (default: server/data/students.db)
# DB_FILE=
